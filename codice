#Fitness
def calcola_fitness(indice, target_cibo, budget, peso_prezzo, dati_vini):

    vino = dati_vini.iloc[int(round(indice))]

    if vino["prezzo"] > budget:
        return -50.0

    #Calcolo distanza quadratica tra vino e target.
    distanza = 0.0

    for f in features:
        distanza += (vino[f] - target_cibo[f]) ** 2

    #Calcolo la distanza euclidea
    distanza_euclidea = np.sqrt(distanza)

    #Penalizza i vini più costosi
    penalita_prezzo = (
        vino["prezzo"] / budget
    ) * peso_prezzo
    
    return -distanza_euclidea + penalita_prezzo

#PSO
class Particella:

    def __init__(self, limite_massimo_righe):

        #Posizione iniziale casuale
        self.posizione = random.uniform(0, limite_massimo_righe)

        #Velocità iniziale casuale
        self.velocita = random.uniform(-1, 1)

        #Migliore posizione personale
        self.pbest_posizione = self.posizione

        #Migliore fitness personale
        self.pbest_fitness = -float("inf")

def pso_sommelier(target_cibo, budget, peso_prezzo, dati_vini, n_particelle=30, iterazioni=50):

    limite_massimo_righe = len(dati_vini) - 1

    sciame = [
        Particella(limite_massimo_righe)
        for _ in range(n_particelle)
    ]

    gbest_posizione = 0
    gbest_fitness = -float("inf")

    #Inizializzazione delle migliori soluzioni personali e globali
    for p in sciame:

        indice = int(round(p.posizione))

        p.pbest_posizione = indice

        p.pbest_fitness = calcola_fitness(indice, target_cibo, budget, peso_prezzo, dati_vini)

        if p.pbest_fitness > gbest_fitness:

            gbest_fitness = p.pbest_fitness
            gbest_posizione = indice

    #Parametri PSO
    w = 0.7
    c1 = 1.5
    c2 = 1.5

    #Evoluzione dello sciame
    for t in range(iterazioni):

        for p in sciame:

            r1 = random.random()
            r2 = random.random()

            #Aggiornamento della velocità con peso d'inerzia
            p.velocita = (
                w * p.velocita
                + c1 * r1 * (p.pbest_posizione - p.posizione)
                + c2 * r2 * (gbest_posizione - p.posizione)
            )

            #Limita la velocità
            p.velocita = max(-3, min(3, p.velocita))

            #Aggiorna la posizione
            p.posizione += p.velocita

            p.posizione = max(
                0,
                min(limite_massimo_righe, p.posizione)
            )

            #Trasforma la posizione continua in un indice discreto perché le colonne sono numeri interi tra cui scegliere
            indice = int(round(p.posizione))

            #Calcola la fitness della soluzione corrente
            fitness_attuale = calcola_fitness(indice, target_cibo, budget, peso_prezzo, dati_vini)

            #Aggiorna il best personale
            if fitness_attuale > p.pbest_fitness:

                p.pbest_fitness = fitness_attuale
                p.pbest_posizione = indice

            #Aggiorna il best globale
            if fitness_attuale > gbest_fitness:

                gbest_fitness = fitness_attuale
                gbest_posizione = indice

    # Restituisce indice e fitness della migliore soluzione trovata
    return gbest_posizione, gbest_fitness

#PSO esecuzione di più sciami
def pso_multiplo(
    target_cibo,
    budget,
    peso_prezzo,
    dati_vini,
    numero_sciami=20
):

    risultati = {}

    #20 sciami indipendenti
    for numero in range(numero_sciami):

        indice, fitness = pso_sommelier(
            target_cibo,
            budget,
            peso_prezzo,
            dati_vini,
            n_particelle=30,
            iterazioni=50
        )

        #conserva la migliore fitness per ogni vino
        if indice not in risultati or fitness > risultati[indice]:
            risultati[indice] = fitness

    #ordina i vini trovati dai diversi sciami
    classifica = sorted(
        risultati.items(),
        key=lambda elemento: elemento[1],
        reverse=True
    )

    #Brute force per trovare il vero massimo globale
    fitness_tutti_vini = [
        calcola_fitness(
            i, target_cibo, budget, peso_prezzo, dati_vini
        )
        for i in range(len(dati_vini))
    ]

    indice_globale = int(np.argmax(fitness_tutti_vini))
    fitness_globale = fitness_tutti_vini[indice_globale]

    return classifica, indice_globale, fitness_globale

#calcolo somiglianza tra valori associati ad ogni caratteristica impostati tramite decisioni dell'user (target) e output del PSO 
def calcola_percentuale_similarita(vino, target_cibo):

    distanza = 0.0
    for f in features:
        distanza += (vino[f] - target_cibo[f]) ** 2

    distanza = np.sqrt(distanza)

    #la distanza massima teorica tra due profili con quattro caratteristiche comprese tra 1 e 5 è 8
    percentuale = (1 - distanza / 8) * 100

    return max(0, min(100, percentuale))

