#parte di pulizia del dataset
def converti_numero(valore):

    if pd.isna(valore):
        return np.nan

    valore = str(valore).strip()
    valore = valore.replace("€", "").replace(" ", "")

    if valore == "":
        return np.nan

    if "," in valore and "." in valore:
        if valore.rfind(",") > valore.rfind("."):
            valore = valore.replace(".", "").replace(",", ".")
        else:
            valore = valore.replace(",", "")

    else:
        valore = valore.replace(",", ".")

    try:
        numero = float(valore)

        if not np.isfinite(numero):
            return np.nan
        return numero

    except ValueError:
        return np.nan


def carica_da_indici(url):
    try:
        df = pd.read_csv(url, encoding="utf-8-sig", dtype=str)

    except Exception as errore:

        raise RuntimeError(
            "Impossibile scaricare il Google Sheets. "
            "Controlla che il foglio sia condiviso con "
            "'Chiunque abbia il link' e che l'URL sia corretto."
        ) from errore

    colonne_necessarie = [
        COLONNA_NOME,
        COLONNA_PREZZO,
        COLONNA_ACIDITA,
        COLONNA_INTENSITA,
        COLONNA_DOLCEZZA,
        COLONNA_TANNINI
    ]

    if len(df.columns) <= max(colonne_necessarie):
        raise ValueError(
            "Il foglio non contiene tutte le colonne richieste. "
            "Controlla gli indici delle colonne."
        )

    # Crea un nuovo database contenente solo i dati necessari
    df_pulito = pd.DataFrame()

    df_pulito["nome"] = (
        df.iloc[:, COLONNA_NOME]
        .fillna("")
        .astype(str)
        .str.strip()
    )

    df_pulito["prezzo"] = (
        df.iloc[:, COLONNA_PREZZO].apply(converti_numero)
    )

    df_pulito["acidita"] = (
        df.iloc[:, COLONNA_ACIDITA].apply(converti_numero)
    )

    df_pulito["intensita"] = (
        df.iloc[:, COLONNA_INTENSITA].apply(converti_numero)
    )

    df_pulito["dolcezza"] = (
        df.iloc[:, COLONNA_DOLCEZZA].apply(converti_numero)
    )

    df_pulito["tannini"] = (
        df.iloc[:, COLONNA_TANNINI].apply(converti_numero)
    )

    numero_iniziale = len(df_pulito)

    df_pulito = df_pulito[
        df_pulito["nome"] != ""
    ].copy()

    caratteristiche_valide = (
        df_pulito[features].notna()
        & df_pulito[features].ge(1)
        & df_pulito[features].le(5)
    ).all(axis=1)

    df_pulito = df_pulito[
        caratteristiche_valide
    ].copy()

    for f in features:
        df_pulito[f] = df_pulito[f].round(2)

    prezzi_mancanti = df_pulito["prezzo"].isna()

    numero_prezzi_simulati = int(prezzi_mancanti.sum())

    generatore = random.Random(42)

    df_pulito.loc[prezzi_mancanti, "prezzo"] = [
        round(
            generatore.uniform(
                PREZZO_MINIMO_CASUALE,
                PREZZO_MASSIMO_CASUALE
            ),
            2
        )
        for _ in range(numero_prezzi_simulati)
    ]

    prezzi_validi = (
        df_pulito["prezzo"].notna()
        & np.isfinite(df_pulito["prezzo"])
        & (df_pulito["prezzo"] >= 0)
    )

    df_pulito = df_pulito[
        prezzi_validi
    ].copy()

    df_pulito["prezzo"] = df_pulito["prezzo"].round(2)

    df_pulito = df_pulito.reset_index(drop=True)

    if df_pulito.empty:
        raise ValueError(
            "Nessun vino valido trovato nel database."
        )

    # stampa se il database è stato letto e pulito correttamente
    print("\nDATABASE CARICATO CORRETTAMENTE")
    print("")
    print("Righe iniziali:", numero_iniziale)
    print("Vini validi:", len(df_pulito))
    print("Prezzi simulati:", numero_prezzi_simulati)
    print(
        "Vini esclusi:",
        numero_iniziale - len(df_pulito)
    )
    print("")

    return df_pulito


